# Grist Stock Tracker Environment Configuration

# Environment: dev | test | production
ENVIRONMENT=dev

# Security
GRIST_SESSION_SECRET=your-super-secret-key-change-this-in-production

# PostgreSQL (optional)
POSTGRES_PASSWORD=your-secure-postgres-password

# S3 Backup (optional)
S3_BUCKET=your-backup-bucket-name
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# API Keys (optional)
ALPHAVANTAGE_API_KEY=your-alphavantage-key
FINNHUB_API_KEY=your-finnhub-key

# Environment-Specific Grist Configuration
# 
# The ENVIRONMENT variable determines which config is loaded:
# - ENVIRONMENT=dev       → uses GRIST_API_KEY, GRIST_DOC_ID
# - ENVIRONMENT=test      → uses TEST_GRIST_API_KEY, TEST_GRIST_DOC_ID  
# - ENVIRONMENT=production → uses PROD_GRIST_API_KEY, PROD_GRIST_DOC_ID

# ---------------------------------------------------------------------------
# Example 1: Local Docker/Podman Deployment (default)
# ---------------------------------------------------------------------------

# Dev (ENVIRONMENT=dev) - Local development
# GRIST_URL=http://localhost:8484
# GRIST_API_KEY=your_dev_api_key
# GRIST_DOC_ID=your_dev_doc_id

# Test (ENVIRONMENT=test) - Local test instance
# TEST_GRIST_URL=http://localhost:8485
# TEST_GRIST_API_KEY=your_test_api_key
# TEST_GRIST_DOC_ID=your_test_doc_id

# Production (ENVIRONMENT=production) - Local production
# PROD_GRIST_URL=http://localhost:8484
# PROD_GRIST_API_KEY=your_prod_api_key
# PROD_GRIST_DOC_ID=your_prod_doc_id

# ---------------------------------------------------------------------------
# Example 2: Network Deployment (custom URLs)
# ---------------------------------------------------------------------------
# Uncomment and modify these for your network Grist instances

# Dev (ENVIRONMENT=dev) - Local development
# GRIST_URL=http://localhost:8484
# GRIST_API_KEY=your_dev_api_key
# GRIST_DOC_ID=your_dev_doc_id

# Test (ENVIRONMENT=test) - Network test instance
TEST_GRIST_URL=http://grist-test.local.test
TEST_GRIST_API_KEY=your_test_api_key
TEST_GRIST_DOC_ID=your_test_doc_id

# Production (ENVIRONMENT=production) - Network production instance
PROD_GRIST_URL=http://grist-prod.local.test
PROD_GRIST_API_KEY=your_prod_api_key
PROD_GRIST_DOC_ID=your_prod_doc_id

# Admin
ADMIN_EMAIL=admin@example.com