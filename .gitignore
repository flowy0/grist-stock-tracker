# Grist Stock Tracker - Git Ignore

# Allow sample CSV files (override global .gitignore)
!samples/*.csv

# Environment files (contain secrets)
.env
docker/.env

# Runtime data (generated by application)
grist-data/
backups/
postgres-data/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.log

# Grist specific
*.grist~  # Grist backup files
