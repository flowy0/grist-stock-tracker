# Grist API Configuration
# Copy this file to .env and fill in your values

# Grist Document ID (found in URL: https://grist.example.com/o/docs/doc/<doc-id>)
GRIST_DOC_ID=your-grist-doc-id

# Grist API Key (generated from Grist UI: Profile > API Keys)
GRIST_API_KEY=your-grist-api-key

# Grist API URL (default for local installation)
GRIST_API_URL=http://localhost:8484/api
